---
/** Titre de section : label, grand titre expressif et introduction. */
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/icon-map";

interface Props {
  eyebrow?: string;
  eyebrowIcon?: IconName;
  title: string;
  intro?: string;
  align?: "left" | "center";
  dark?: boolean;
  class?: string;
}

const {
  eyebrow,
  eyebrowIcon = "sparkles",
  title,
  intro,
  align = "left",
  dark = false,
  class: className = "",
} = Astro.props;

const alignment = align === "center" ? "items-center text-center" : "items-start text-left";
---

<div
  class:list={["flex flex-col", alignment, className]}
  data-reveal
>
  {
    eyebrow && (
      <p class:list={["eyebrow", dark && "eyebrow-on-dark"]}>
        <Icon name={eyebrowIcon} class="size-4" />
        {eyebrow}
      </p>
    )
  }

  <h2
    class:list={[
      "mt-4 max-w-3xl text-3xl leading-[1.08] sm:text-4xl lg:text-[2.6rem]",
      dark && "text-cream",
    ]}
  >
    {title}
  </h2>

  {
    intro && (
      <p
        class:list={[
          "mt-5 max-w-2xl text-[1.05rem] leading-relaxed",
          dark ? "text-cream/85" : "text-ink-soft",
        ]}
      >
        {intro}
      </p>
    )
  }
</div>
