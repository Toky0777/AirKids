---
/**
 * Informations pratiques : adresse, contact, jours et horaires.
 * Réutilisé sur la page d'accueil et la page contact.
 */
import Icon from "@/components/Icon.astro";
import { hoursNote, hoursSummary } from "@/data/hours";
import { site } from "@/data/site";
---

<div class="grid gap-5 lg:grid-cols-2">
  <div class="card-soft flex flex-col p-6 sm:p-8" data-reveal>
    <div class="icon-chip bg-sky/25 text-sky-deep">
      <Icon name="map-pin" class="size-6" />
    </div>
    <h3 class="mt-4 font-display text-2xl font-semibold text-forest">Nous trouver</h3>
    <p class="mt-3 leading-relaxed text-ink-soft">
      {site.address.street}<br />
      {site.address.city} {site.address.postalCode} — {site.address.country}
    </p>
    <a
      href={site.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="link-more mt-5 self-start"
    >
      Ouvrir l'itinéraire sur Google Maps
      <Icon name="external-link" class="size-4" />
    </a>
    <p class="mt-4 text-sm text-ink-soft/90">
      Le lien ouvre une nouvelle fenêtre : aucune donnée n'est transmise avant votre clic.
    </p>
  </div>

  <div class="card-soft flex flex-col p-6 sm:p-8" data-reveal style="--reveal-delay: 90ms">
    <div class="icon-chip bg-coral/25 text-coral-deep">
      <Icon name="phone-call" class="size-6" />
    </div>
    <h3 class="mt-4 font-display text-2xl font-semibold text-forest">Nous joindre</h3>
    <a
      href={site.phone.href}
      class="mt-4 font-display text-2xl font-semibold text-forest underline-offset-4 hover:underline"
    >
      {site.phone.display}
    </a>
    <ul class="mt-4 space-y-2 text-[15px]">
      <li>
        <a
          href={`mailto:${site.emails.primary}`}
          class="inline-flex items-center gap-2 text-ink-soft underline-offset-4 hover:text-forest hover:underline"
        >
          <Icon name="mail" class="size-4 text-sage-deep" />
          {site.emails.primary}
        </a>
      </li>
      <li>
        <a
          href={`mailto:${site.emails.direction}`}
          class="inline-flex items-center gap-2 text-ink-soft underline-offset-4 hover:text-forest hover:underline"
        >
          <Icon name="mail" class="size-4 text-sage-deep" />
          {site.emails.direction}
        </a>
      </li>
    </ul>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href={site.phone.href} class="btn btn-primary px-6 py-3 text-base">
        <Icon name="phone" class="size-5" />
        Appeler l'école
      </a>
      <a href={`mailto:${site.emails.primary}`} class="btn btn-outline px-6 py-3 text-base">
        <Icon name="mail" class="size-5" />
        Envoyer un e-mail
      </a>
    </div>
  </div>

  <div class="card-soft p-6 sm:p-8 lg:col-span-2" data-reveal>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <div class="icon-chip bg-sun/35 text-ink">
          <Icon name="clock" class="size-6" />
        </div>
        <h3 class="mt-4 font-display text-2xl font-semibold text-forest">Jours et horaires</h3>
        <p class="mt-2 text-ink-soft">
          L'école accueille les enfants du <strong>lundi au vendredi</strong>.
        </p>
      </div>

      <dl class="grid w-full max-w-xl gap-3 sm:grid-cols-2">
        {
          hoursSummary.map((row) => (
            <div class="rounded-2xl bg-cream px-4 py-3">
              <dt class="text-xs font-bold uppercase tracking-wide text-ink-soft">{row.label}</dt>
              <dd class="mt-1 font-display text-lg font-semibold text-forest">{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="mt-6 flex items-start gap-2 rounded-2xl bg-sky/15 px-4 py-3 text-sm text-ink-soft">
      <Icon name="info" class="mt-0.5 size-4 shrink-0 text-sky-deep" />
      <span>
        {hoursNote}
        <a href="/nos-services/#horaires" class="font-bold text-forest underline underline-offset-4">
          Voir le détail des horaires
        </a>
      </span>
    </p>
  </div>
</div>
